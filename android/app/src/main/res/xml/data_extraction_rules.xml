<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (android:dataExtractionRules). Same intent as backup_rules.xml:
  history survives a reinstall, confessions never leave the device.

  device-transfer is included so moving to a new phone carries the couple's
  history across; cloud-backup carries it across a reinstall.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="exodus.confessions.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="exodus.confessions.xml" />
    </device-transfer>
</data-extraction-rules>
