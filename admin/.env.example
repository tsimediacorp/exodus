# Required. The password for the panel itself.
ADMIN_PASSWORD=change-me

# Required. Any long random string; signs the session cookie.
# openssl rand -hex 32
ADMIN_SECRET=

# Optional but STRONGLY recommended for production.
# Without these the config lives in a temp file that Vercel discards between
# deploys and between serverless invocations, so settings will not stick.
# Add the Upstash Redis integration in the Vercel dashboard and these appear
# automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=
